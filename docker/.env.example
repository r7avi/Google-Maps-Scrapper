# Copy to docker/.env and fill in. Never commit the filled-in file --
# docker/.env is listed in .gitignore.
#
# Earlier versions of this project kept these values as constants in
# utils.py, which meant real credentials ended up in git history.

GMAPS_UPLOAD=1

GMAPS_SFTP_HOST=sftp.example.com
GMAPS_SFTP_PORT=22
GMAPS_SFTP_USER=scraper
GMAPS_SFTP_REMOTE_DIR=/home/scraper-output

# Key-based auth is preferred. Mount the key into the container and point
# this at the in-container path.
GMAPS_SFTP_KEY=/run/secrets/sftp_key
# GMAPS_SFTP_KEY_PASS=

# Password auth is used only when no key is supplied.
# GMAPS_SFTP_PASSWORD=

# Host keys are verified, so this file must contain the server's key.
# Generate it with:  ssh-keyscan -H sftp.example.com > known_hosts
# after confirming the fingerprint through a trusted channel.
GMAPS_SFTP_KNOWN_HOSTS=/app/known_hosts
